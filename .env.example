# Copy this file to .env and fill in your keys. .env is never committed to git.

# Sarvam AI speech (speech-to-text + Indian voices). Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional: Bulbul v3 voice, e.g. priya, rahul, neha, aditya
SARVAM_SPEAKER=priya

# Optional: Claude for understanding orders in Hindi/Hinglish and open questions.
ANTHROPIC_API_KEY=

# Password for the Admin tab (users, test runs, COD cap). Leave empty only on your own laptop.
ADMIN_KEY=
